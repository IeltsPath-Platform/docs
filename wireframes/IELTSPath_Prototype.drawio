tColor=#123AB5;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="284" width="600" height="20" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;EssayBlock&lt;/b&gt; — Task 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="306" width="500" height="26" as="geometry"/></mxCell><mxCell id="c33" value="The graph below shows the number of visitors to three museums between 2000 and 2020. Summarise the information by selecting and reporting the main features." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="342" width="780" height="44" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="394" width="380" height="150" as="geometry"/></mxCell><mxCell id="c35" value="▨ Biểu đồ đề bài" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="457.0" width="380" height="24" as="geometry"/></mxCell><mxCell id="c36" value="Tối thiểu 150 từ · đạt từ band 5.5 · mỗi lần chấm tốn 3 điểm (còn 27)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="554" width="780" height="20" as="geometry"/></mxCell><mxCell id="c37" value="B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="64" y="584" width="26" height="26" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Bài làm của bạn&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="584" width="300" height="22" as="geometry"/></mxCell><mxCell id="c39" value="The line graph illustrates how many people visited three museums …" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=1;fontFamily=Arial;fontSize=13;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="610" width="780" height="170" as="geometry"/></mxCell><mxCell id="c40" value="162 từ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="786" width="200" height="20" as="geometry"/></mxCell><UserObject label="Nộp bài · 3 điểm" link="data:page/id,P-32-Writing-Feedback-t" id="c41"><mxCell style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="790" width="180" height="42" as="geometry"/></mxCell></UserObject><mxCell id="c42" value="C" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="64" y="854" width="26" height="26" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Band ước lượng: 5.0 · Chưa đạt&lt;/b&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;strokeWidth=1;fontFamily=Arial;fontSize=15;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="854" width="780" height="50" as="geometry"/></mxCell><mxCell id="c44" value="The essay covers the main trends but the overview is missing and some figures are not compared." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="914" width="780" height="44" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Tiêu chí&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="962" width="300" height="22" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;TA&lt;/b&gt; · band 5.0 — Add a clear overview of the main trends." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="990" width="780" height="34" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;CC&lt;/b&gt; · band 5.5 — Group the museums by trend, not by year." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="1030" width="780" height="34" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;LR&lt;/b&gt; · band 5.5 — Vary the verbs for increase and decrease." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="1070" width="780" height="34" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;GRA&lt;/b&gt; · band 5.0 — Check the past tense in comparisons." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="1110" width="780" height="34" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Sửa lỗi&lt;/b&gt; (5 lỗi đầu)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1156" width="300" height="22" as="geometry"/></mxCell><mxCell id="c51" value="&lt;s&gt;visitor of the museum&lt;/s&gt; → &lt;b&gt;visitors to the museum&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1184" width="780" height="22" as="geometry"/></mxCell><mxCell id="c52" value="&lt;s&gt;increase dramatic&lt;/s&gt; → &lt;b&gt;increased dramatically&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1210" width="780" height="22" as="geometry"/></mxCell><mxCell id="c53" value="&lt;s&gt;in the other hand&lt;/s&gt; → &lt;b&gt;on the other hand&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1236" width="780" height="22" as="geometry"/></mxCell><mxCell id="c54" value="▸ &lt;b&gt;Bài mẫu&lt;/b&gt;" style="rounded=1;arcSi