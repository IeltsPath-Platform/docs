 y="320" width="420" height="18" as="geometry"/></mxCell><mxCell id="c55" value="✎ Sửa" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="320" width="70" height="18" as="geometry"/></mxCell><mxCell id="c56" value="Overall, while Turkey and France showed a general increase in fruit production, Spain and Germany experienced a decline, particularly in the latter part of the period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="340" width="570" height="54" as="geometry"/></mxCell><mxCell id="c57" value="3" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#123AB5;strokeWidth=3;fontFamily=Arial;fontSize=11;fontColor=#123AB5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="417" y="408" width="20" height="20" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;3 · Body 1 — Câu chủ đề&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="406" width="500" height="18" as="geometry"/></mxCell><mxCell id="c59" value="Nêu ý chính của đoạn: nước nào dẫn đầu và so sánh với các nước còn lại." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="428" width="570" height="20" as="geometry"/></mxCell><mxCell id="c60" value="Throughout the entire period, Spain maintained its position as the leading fruit producer among the four nations" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EDFB;strokeColor=#123AB5;