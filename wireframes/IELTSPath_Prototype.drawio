ght=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="1108" width="86" height="20" as="geometry"/></mxCell><mxCell id="c116" value="Từ vựng" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EDFB;strokeColor=#E8EDFB;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="236" y="1108" width="86" height="20" as="geometry"/></mxCell><mxCell id="c117" value="Mạch lạc" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="332" y="1108" width="86" height="20" as="geometry"/></mxCell><mxCell id="c118" value="The line graph illustrates the fruit production, measured in millions of tonnes, in four different countries (Spain, Turkey, France, and Germany) over a 40-year period from 1970 to 2010. Overall, while Turkey and France showed a general increase in fruit production, Spain and Germany experienced a decline." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="140" y="1144" width="720" height="90" as="geometry"/></mxCell><mxCell id="c119" value="Turkey's production increased steadily, and France's production also &lt;span style='background-color:#E8EDFB'&gt;increased&lt;/span&gt; to about 8 million tonnes. In contrast, Germany's output &lt;span style='background-color:#FDE68A'&gt;decrease&lt;/span&gt; sharply after 2000, &lt;span style='background-color:#E5E7EB'&gt;so&lt;/span&gt; it ended at the lowest level of the four countries." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="140" y="1244" width="720" height="90" as="geometry"/></mxCell><mxCell id="c120" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="1092" width="420" height="300" as="geometry"/></mxCell><mxCell id="c121" value="&lt;b&gt;Gợi ý sửa (3)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1104" width="380" height="22" as="geometry"/></mxCell><mxCell id="c122" value="Ngữ pháp" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#FDE68A;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="1146" width="76" height="20" as="geometry"/></mxCell><mxCell id="c123" value="&lt;b&gt;decrease → decreased&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1172" width="380" height="22" as="geometry"/></mxCell><mxCell id="c124" value="Mô tả quá khứ (1970–2010) dùng thì quá khứ đơn." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1194" width="380" height="32" as="geometry"/></mxCell><mxCell id="c125" value="Từ vựng" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EDFB;strokeColor=#E8EDFB;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="1226" width="76" height="20" as="geometry"/></mxCell><mxCell id="c126" value="&lt;b&gt;increased (lần 2) → rose&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1252" width="380" height="22" as="geometry"/></mxCell><mxCell id="c127" value="Tránh lặp từ; dùng rise / climb / grow." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1274" width="380" height="32" as="geometry"/></mxCell><mxCell id="c128" value="Mạch lạc" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="1306" width="76" height="20" as="geometry"/></mxCell><mxCell id="c129" value="&lt;b&gt;so → whereas&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1332" width="380" height="22" as="geometry"/></mxCell><mxCell id="c130" value="Dùng từ nối đối lập khi so sánh hai quốc gia." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1354" width="380" height="32" as="geometry"/></mxCell><mxCell id="c131" value="E" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="88" y="1408" width="26" height="26" as="geometry"/></mxCell><mxCell id