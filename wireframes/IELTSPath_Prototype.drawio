enter;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="288" width="81" height="24" as="geometry"/></mxCell><mxCell id="c34" value="The graph below shows the number of visitors to three museums between 2000 and 2020. Summarise the information by selecting and reporting the main features." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="342" width="780" height="44" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="394" width="380" height="150" as="geometry"/></mxCell><mxCell id="c36" value="▨ Biểu đồ đề bài" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="457.0" width="380" height="24" as="geometry"/></mxCell><mxCell id="c37" value="Tối thiểu 150 từ · đạt từ band 5.5 · mỗi lần chấm tốn 3 điểm (còn 27)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="554" width="780" height="20" as="geometry"/></mxCell><mxCell id="c38" value="C" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="64" y="584" width="26" height="26" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Band ước lượng: 6.0 · Đạt&lt;/b&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EDFB;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=15;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="584" width="780" height="50" as="geometry"/></mxCell><mxCell id="c40" value="The essay covers the main trends but the overview is missing and some figures are not compared." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="644" width="780" height="44" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Tiêu chí&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="692" width="300" height="22" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;TA&lt;/b&gt; · band 5.0 — Add a clear overview of the main trends." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="720" width="780" height="34" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;CC&lt;/b&gt; · band 5.5 — Group the museums by trend, not by year." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="760" width="780" height="34" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;LR&lt;/b&gt; · band 5.5 — Vary the verbs for increase and decrease." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="800" width="780" height="34" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;GRA&lt;/b&gt; · band 5.0 — Check the past tense in comparisons." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="840" width="780" height="34" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Sửa lỗi&lt;/b&gt; (5 lỗi đầu)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="886" width="300" height="22" as="geometry"/></mxCell><mxCell id="c47" value="&lt;s&gt;visitor of the museum&lt;/s&gt; → &lt;b&gt;visitors to the museum&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="914" width="780" height="22" as="geometry"/></mxCell><mxCell id="c48" value="&lt;s&gt;increase dramatic&lt;/s&gt; → &lt;b&gt;increased dramatically&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="940" width="780" height="22" as="geometry"/></mxCell><mxCell id="c49" value="&lt;s&gt;in the other hand&lt;/s&gt; → &lt;b&gt;on the other hand&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="966" width="780" height="22" as="geometry"/></mxCell><mxCell id="c50" value="▸ &lt;b&gt;Bài mẫu&lt;/b&gt;" style="rounded=1;arcSize=8;