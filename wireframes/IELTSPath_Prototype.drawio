iếu" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="726" y="676" width="690" height="20" as="geometry"/></mxCell><mxCell id="c100" value="Đoạn 1 nói thủ môn Júlio César chê bóng &lt;b&gt;trước&lt;/b&gt; khi World Cup 2010 bắt đầu, trái với câu hỏi (sau khi kết thúc) → &lt;b&gt;FALSE&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="726" y="697" width="690" height="20" as="geometry"/></mxCell><mxCell id="c101" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1424" y="516" width="4" height="100" as="geometry"/></mxCell><mxCell id="c102" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="0" y="750" width="1440" height="54" as="geometry"/></mxCell><mxCell id="c103" value="E" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="14" y="764" width="26" height="26" as="geometry"/></mxCell><mxCell id="c104" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="94" y="756" width="372" height="42" as="geo