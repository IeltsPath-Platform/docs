" parent="1"><mxGeometry x="120" y="990" width="780" height="34" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;CC&lt;/b&gt; · band 5.5 — Group the museums by trend, not by year." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="1030" width="780" height="34" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;LR&lt;/b&gt; · band 5.5 — Vary the verbs for increase and decrease." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="1070" width="780" height="34" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;GRA&lt;/b&gt; · band 5.0 — Check the past tense in comparisons." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="1110" width="780" height="34" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Sửa lỗi&lt;/b&gt; (5 lỗi đầu)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1156" width="300" height="22" as="geometry"/></mxCell><mxCell id="c51" value="&lt;s&gt;visitor of the museum&lt;/s&gt; → &lt;b&gt;visitors to the museum&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1184" width="780" height="22" as="geometry"/></mxCell><mxCell id="c52" value="&lt;s&gt;increase dramatic&lt;/s&gt; → &lt;b&gt;increased dramatically&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1210" width="780" height="22" as="geometry"/></mxCell><mxCell id="c53" value="&lt;s&gt;in the other hand&lt;/s&gt; → &lt;b&gt;on the other hand&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1236" width="780" height="22" as="geometry"/></mxCell><mxCell id="c54" value="▸ &lt;b&gt;Bài mẫu&lt;/b&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=13;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="1276" width="780" height="40" as="geometry"/></mxCell><mxCell id="c55" value="Band là ước lượng AI, không phải điểm IELTS chính thức." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#6B7280;fontStyle=2;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1328" width="780" height="20" as="geometry"/></mxCell><mxCell id="c56" value="" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="960" y="184" width="380" height="240" as="geometry"/></mxCell><mxCell id="c57" value="BÀI 3 · WRITING" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#6B7280;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="980" y="200" width=