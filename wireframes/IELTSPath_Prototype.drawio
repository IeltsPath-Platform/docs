iddle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1100" y="396" width="96" height="8" as="geometry"/></mxCell><mxCell id="c65" value="" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1100" y="396" width="19" height="8" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;Many countries are investing in&lt;/b&gt; &lt;span style='background-color:#FFE8D6;color:#F97316;'&gt;&lt;b&gt;&amp;nbsp;renewable energy&amp;nbsp;&lt;/b&gt;&lt;/span&gt; &lt;b&gt;, such as solar and wind power, to reduce pollution.&lt;/b&gt; 🔊" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EDFB;strokeColor=#E8EDFB;strokeWidth=1;fontFamily=Arial;fontSize=16;fontColor=#123AB5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="244" y="482" width="952" height="64" as="geometry"/></mxCell><mxCell id="c67" value="✓ &lt;b&gt;Chính xác!&lt;/b&gt; Renewable energy là năng lượng tái tạo." style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=1;fontFamily=Arial;fontSize=13;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="244" y="562" width="952" height="40" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=1;arcSize=18;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=none;strokeWidth=1;fontFamily=Arial;gradientColor=#F97316;gradientDirection=east;shadow=1;" vertex="1" parent="1"><mxGeometry x="430.0" y="626" width="580" height="300" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;MẶT SAU&lt;/b&gt;" style="rounded=1;arcSize=11;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#4A6FF0;strokeColor=none;s