"78" as="geometry"/></mxCell><mxCell id="c39" value="The line graph below shows the fruit production in four countries (Spain, Turkey, France and Germany) between 1970 and 2010. Summarize the information by selecting and reporting the main features and make comparisons where relevant." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1F2937;fontStyle=2;spacing=0;" vertex="1" parent="1"><mxGeometry x="28" y="198" width="340" height="74" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="288" width="356" height="420" as="geometry"/></mxCell><mxCell id="c41" value="▨ Line graph · fruit production (million tonnes), 1970–2010" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="486" width="356" height="24" as="geometry"/></mxCell><mxCell id="c42" value="⤢ Phóng to biểu đồ" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="170" height="30" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="396" y="176" width="640" height="616" as="geometry"/></mxCell><mxCell id="c44" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#F3F4F6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="397" y="177" width="638" height="44" as="geometry"/></mxCell><mxCell id="c45" value="C" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="383" y="163" width="26" height="26" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;✍ Hướng dẫn từng bước&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="412" y="188" width="300" height="22" as="geometry"/></mxCell><mxCell id="c47" value="Word count: 187" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="880" y="188" width="140" height="22" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#C9CED6;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="426" y="246" width="2" height="400" as="geometry"/></mxCell><mxCell id="c49" value="✓" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="417" y="236" width="20" height="20" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;1 · Introduction&lt;/b&gt; — Paraphrase đề bài" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="234" width="420" height="18" as="geometry"/></mxCell><mxCell id="c51" value="✎ Sửa" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="234" width="70" height="18" as="geometry"/></mxCell><mxCell id="c52" value="The line graph illustrates the fruit production, measured in millions of tonnes, in four different countries (Spain, Turkey, France, and Germany) over a 40-year period from 1970 to 2010." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="254" width="570" height="40" as="geometry"/></mxCell><mxCell id="c53" value="✓" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="417" y="316" width="20" height="20" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;2 · Overview&lt;/b&gt; — Nhận xét chung" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="314" width="420" height="18" as="geometry"/></mxCell><mxCell id="c55" value="✎ Sửa" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="314" width="70" height="18" as="geometry"/></mxCell><mxCell id="c56" value="Overall, while Turkey and France showed a general increase in fruit production, Spain and Germany experienced a decline, particularly in the latter part of the period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="334" width="570" height="40" as="geometry"/></mxCell><mxCell id="c57" value="✓" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="417" y="396" width="20" height="20" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;3 · Body 1&lt;/b&gt; — Câu chủ đề" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="394" width="420" height="18" as="geometry"/></mxCell><mxCell id="c59" value="✎ Sửa" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="394" width="70" height="18" as="geometry"/></mxCell><mxCell id="c60" value="Throughout the entire period, Spain maintained its position as the leading fruit producer among the four nations." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="414" width="570" height="40" as="geometry"/></mxCell><mxCell id="c61" value="✓" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="417" y="476" width="20" height="20" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;4 · Body 1&lt;/b&gt; — Tả trend Spain (1970–2010)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="474" width="420" height="18" as="geometry"/></mxCell><mxCell id="c63" value="✎ Sửa" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="474" width="70" height="18" as="geometry"/></mxCell><mxCell id="c64" value="Spain's production fell gradually from about 14 million tonnes in 1970 to 9 million tonnes in 2010." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="494" width="570" height="40" as="geometry"/></mxCell><mxCell id="c65" value="✓" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="417" y="556" width="20" height="20" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;5 · Body 2&lt;/b&gt; — Câu chủ đề" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="554" width="420" height="18" as="geometry"/></mxCell><mxCell id="c67" value="✎ Sửa" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="554" width="70" height="18" as="geometry"/></mxCell><mxCell id="c68" value="Turning to the other countries, Turkey and France showed a pattern that contrasted with Germany." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="574" width="570" height="40" as="geometry"/></mxCell><mxCell id="c69" value="✓" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="417" y="636" width="20" height="20" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;6 · Body 2&lt;/b&gt; — Tả trend Turkey &amp; France" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="634" width="420" height="18" as="geometry"/></mxCell><mxCell id="c71" value="✎ Sửa" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="950" y="634" width="70" height="18" as="geometry"/></mxCell><mxCell id="c72" value="Turkey's output rose steadily to about 12 million tonnes, while France's reached about 8 million tonnes by 2010." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="448" y="654" width="570" height="40" as="geometry"/></mxCell><mxCell id="c73" value="Đã xong cả 6 bước — sẵn sàng chấm điểm" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#6B7280;fontStyle=2;spacing=0;" vertex="1" parent="1"><mxGeometry x="412" y="758" width="400" height="20" as="geometry"/></mxCell><mxCell id="c74" value="Chấm điểm" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;f