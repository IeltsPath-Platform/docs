 who designed this ball never played football.'" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="232" width="658" height="86" as="geometry"/></mxCell><mxCell id="c42" value="" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="330" width="658" height="8" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="352" width="658" height="8" as="geometry"/></mxCell><mxCell id="c44" value="" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="374" width="658" height="8" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="396" width="658" height="8" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="4