lign=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="126" width="560" height="28" as="geometry"/></mxCell><mxCell id="c33" value="⏱ 00:01:05" style="rounded=1;arcSize=32;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="694" y="124" width="100" height="32" as="geometry"/></mxCell><mxCell id="c34" value="Band Score: &lt;b&gt;2.5&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="808" y="126" width="160" height="28" as="geometry"/></mxCell><mxCell id="c35" value="⚙ Cài đặt" style="rounded=1;arcSize=34;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1134" y="123" width="107" height="34" as="geometry"/></mxCell><mxCell id="c36" value="↗ Chia sẻ bài làm" style="rounded=1;arcSize=34;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1251" y="123" width="167" height="34" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="8" y="172" width="690" height="570" as="geometry"/></mxCell><mxCell id="c38" value="B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="656" y="178" width="26" height="26" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;William:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="186" width="76" height="20" as="geometry"/></mxCell><mxCell id="c40" value="Okay.&lt;br&gt;Let's get started.&lt;br&gt;What's the best phone number to contact you on?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="186" width="580" height="60" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Grace:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="260" width="76" height="20" as="geometry"/></mxCell><mxCell id="c42" value="My mobile phone's probably best.&lt;br&gt;The number's 0216367189.&lt;br&gt;But I can't always answer it during the day." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="260" width="580" height="60" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;William:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="334" width="76" height="20" as="geometry"/></mxCell><mxCell id="c44" value="Okay.&lt;br&gt;I'll make a note that email's a good way to contact you.&lt;br&gt;What's the address?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="334" width="580" height="60" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Grace:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="408" width="76" height="20" as="geometry"/></mxCell><mxCell id="c46" value="&lt;span style='background-color:#E8EDFB'&gt;It's graceb@travel.co.nz.&lt;/span&gt;&lt;br&gt;I chose it when I was younger, and I just haven't changed it since." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="408" width="580" height="40" as="geometry"/></mxCell><mxCell id="c47" value="Câu 1" style="rounded=1;arcSize=18;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="409" width="56" height="18" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;William:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="462" width="76" height="20" as="geometry"/></mxCell><mxCell id="c49" value="It's easy to remember.&lt;br&gt;Now do you have any particular qualifications, Grace?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="462" width="580" height="40" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Grace:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="516" width="76" height="20" as="geometry"/></mxCell><mxCell id="c51" value="I'm a housewife now, but I used to be in teaching.&lt;br&gt;I trained for that and got my diploma, although I haven't done it for years." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="516" width="580" height="40" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;William:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="570" width="76" height="20" as="geometry"/></mxCell><mxCell id="c53" value="Alright.&lt;br&gt;I need to find out when you'll be available during the week." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="570" width="580" height="40" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="690" y="180" width="4" height="90" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#C9CED6;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="9" y="682" width="688" height="1" as="geometry"/></mxCell><mxCell id="c56" value="00:00 / 06:13" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="699" width="110" height="24" as="geometry"/></mxCell><mxCell id="c57" value="🔊" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="134" y="699" width="24" height="24" as="geometry"/></mxCell><mxCell id="c58" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="162" y="708" width="130" height="6" as="geometry"/></mxCell><mxCell id="c59" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="162" y="708" width="7" height="6" as="geometry"/></mxCell><mxCell id="c60" value="↺5" style="rounded=1;arcSize=28;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="699" width="28" height="28" as="geometry"/></mxCell><mxCell id="c61" value="▶" style="rounded=1;arcSize=34;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="368" y="696" width="34" height="34" as="geometry"/></mxCell><mxCell id="c62" value="↻5" style="rounded=1;arcSize=28;absoluteA