;" vertex="1" parent="1"><mxGeometry x="130" y="348" width="1180" height="24" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;&lt;font color='#123AB5'&gt;Kiểm tra và đảm bảo Loa/Tai nghe và Microphone đã kết nối.&lt;/font&gt;&lt;/b&gt; Hãy Test microphone trước khi làm bài để bài làm được ghi nhận đầy đủ." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="386" width="1120" height="64" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;&lt;font color='#123AB5'&gt;Làm bài ở nơi yên tĩnh, ít tiếng ồn.&lt;/font&gt;&lt;/b&gt; Nói gần microphone để ghi âm được chất lượng tốt nhất; tạp âm ảnh hưởng tới việc chấm điểm." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="460" width="1120" height="64" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;&lt;font color='#123AB5'&gt;Lưu ý giới hạn thời gian trả lời!&lt;/font&gt;&lt;/b&gt; Giống thi thật, hệ thống chuyển sang câu tiếp theo khi hết thời gian của câu." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="160" y="534" width="1120" height="64" as="geometry"/></mxCell><mxCell id="c41" value="&lt;i&gt;(*) Từ sau màn này, toàn bộ hướng dẫn làm bài sẽ là Tiếng Anh.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="130" y="620" width="1180" height="24" as="geometry"/></mxCell><mxCell id="c42" value="▶| Next step" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=15;fontColor=#FFFFFF;align=center;vertica