xCell><mxCell id="c101" value="Relating to the protection of the environment and the wise use of natural resources." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="124" y="746" width="772" height="22" as="geometry"/></mxCell><mxCell id="c102" value="🔊 &lt;b&gt;Sustainable practices help reduce pollution and preserve natural resources.&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280'&gt;Các thực hành bền vững giúp giảm ô nhiễm và bảo tồn tài nguyên thiên nhiên.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="124" y="772" width="772" height="44" as="geometry"/></mxCell><mxCell id="c103" value="" style="rounded=0;arcSize=0;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#C9CED6;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="124" y="836" width="772" height="1" as="geometry"/></mxCell><mxCell id="c104" value="&lt;b&gt;Word family&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="124" y="854" width="300" height="22" as="geometry"/></mxCell><mxCell id="c105" value="sustain (v), sustainability (n), sustainably (adv), unsustainable (adj)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="124" y="880" width="772" height="22" as="geometry"/></mxCell><mxCell id="c106" value="&lt;b&gt;Lỗi thường gặp&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyl