l id="c43" value="&lt;b&gt;William:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="334" width="76" height="20" as="geometry"/></mxCell><mxCell id="c44" value="Okay.&lt;br&gt;I'll make a note that email's a good way to contact you.&lt;br&gt;What's the address?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="334" width="580" height="60" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Grace:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="408" width="76" height="20" as="geometry"/></mxCell><mxCell id="c46" value="&lt;span style='background-color:#E8EDFB'&gt;It's graceb@travel.co.nz.&lt;/span&gt;&lt;br&gt;I chose it when I was younger, and I just haven't changed it since." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="408" width="580" height="40" as="geometry"/></mxCell><mxCell id="c47" value="Câu 1" style="rounded=1;arcSize=18;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#123AB5;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="409" width="56" height="18" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;William:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="462" width="76" height="20" as="geometry"/></mxCell><mxCell id="c49" value="It's easy to remember.&lt;br&gt;Now do you have any particular qualifications, Grace?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="462" width="580" height="40" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Grace:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="516" width="76" height="20" as="geometry"/></mxCell><mxCell id="c51" value="I'm a housewife now, but I used to be in teaching.&lt;br&gt;I trained for that and got my diploma, although I haven't done it for years." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="516" width="580" height="40" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;William:&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="570" width="76" height="20" as="geometry"/></mxCell><mxCell id="c53" value="Alright.&lt;br&gt;I need to find out when you'll be available during the week." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="104" y="570" width="580" height="40" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;arcSize=2;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="690" y="180" width="4" height="90" as="geometry"/></m