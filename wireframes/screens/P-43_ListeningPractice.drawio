gRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="868" width="140" height="20" as="geometry"/></mxCell><mxCell id="c102" value="&lt;b&gt;✓ Làm tốt:&lt;/b&gt; Từ vựng đủ để mô tả biểu đồ." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="140" y="944" width="550" height="20" as="geometry"/></mxCell><mxCell id="c103" value="&lt;b&gt;△ Cần cải thiện:&lt;/b&gt; Lặp “increase” 6 lần, thiếu từ đồng nghĩa (rise, climb, grow)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="140" y="964" width="550" height="20" as="geometry"/></mxCell><mxCell id="c104" value="&lt;u&gt;Xem lỗi liên quan ›&lt;/u&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="986" width="170" height="16" as="geometry"/></mxCell><mxCell id="c105" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="730" y="850" width="590" height="160" as="geometry"/></mxCell><mxCell id="c106" value="6.0" style="rounded=1;arcSize=64;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EDFB;strokeColor=#123AB5;strokeWidth=1;fontFamily=Arial;fontSize=18;fontColor=#123AB5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="870" width="64" height="64" as="geometry"/></mxCell><mxCell id="c107" value="&lt;b&gt;Grammatical Range &amp; Accuracy&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="830" y="868" width="300" height="22" as="geometry"/></mxCell><mxCell id="c108" value="Ngữ pháp" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="830" y="892" width="300" height="18" as="geometry"/></mxCell><mxCell id="c109" value="&lt;b&gt;✓ Làm tốt:&lt;/b&gt; Có dùng câu phức và câu so sánh." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="750" y="944" width="550" height="20" as="geometry"/></mxCell><mxCell id="c110" value="&lt;b&gt;△ Cần cải thiện:&lt;/b&gt; 7 lỗi mạo từ và chia thì, chủ yếu ở đoạn thân bài." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="750" y="964" width="550" height="20" as="geometry"/></mxCell><mxCell id="c111" value="&lt;u&gt;Xem lỗi liên quan ›&lt;/u&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#123AB5;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1130" y="986" width="170" height="16" as="geometry"/></mxCell><mxCell id="c112" value="D" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="88" y="1052" width="26" height="26" as="geometry"/></mxCell><mxCell id="c113" value="&lt;b&gt;Bài viết của bạn đã được đánh dấu&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1050" width="800" height="30" as="geometry"/></mxCell><mxCell id="c114" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="1092" width="760" height="300" as="geometry"/></mxCell><mxCell id="c115" value="Ngữ pháp" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#FDE68A;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="1108" width="86" height="20" as="geometry"/></mxCell><mxCell id="c116" value="Từ vựng" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EDFB;strokeColor=#E8EDFB;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="236" y="1108" width="86" height="20" as="geometry"/></mxCell><mxCell id="c117" value="Mạch lạc" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="332" y="1108" width="86" height="20" as="geometry"/></mxCell><mxCell id="c118" value="The line graph illustrates the fruit production, measured in millions of tonnes, in four different countries (Spain, Turkey, France, and Germany) over a 40-year period from 1970 to 2010. Overall, while Turkey and France showed a general increase in fruit production, Spain and Germany experienced a decline." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="140" y="1144" width="720" height="90" as="geometry"/></mxCell><mxCell id="c119" value="Turkey's production increased steadily, and France's production also &lt;span style='background-color:#E8EDFB'&gt;increased&lt;/span&gt; to about 8 million tonnes. In contrast, Germany's output &lt;span style='background-color:#FDE68A'&gt;decrease&lt;/span&gt; sharply after 2000, &lt;span style='background-color:#E5E7EB'&gt;so&lt;/span&gt; it ended at the lowest level of the four countries." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="140" y="1244" width="720" height="90" as="geometry"/></mxCell><mxCell id="c120" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9CED6;strokeWidth=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="1092" width="420" height="300" as="geometry"/></mxCell><mxCell id="c121" value="&lt;b&gt;Gợi ý sửa (3)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1104" width="380" height="22" as="geometry"/></mxCell><mxCell id="c122" value="Ngữ pháp" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#FDE68A;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="1146" width="76" height="20" as="geometry"/></mxCell><mxCell id="c123" value="&lt;b&gt;decrease → decreased&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1172" width="380" height="22" as="geometry"/></mxCell><mxCell id="c124" value="Mô tả quá khứ (1970–2010) dùng thì quá khứ đơn." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1194" width="380" height="32" as="geometry"/></mxCell><mxCell id="c125" value="Từ vựng" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EDFB;strokeColor=#E8EDFB;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="1226" width="76" height="20" as="geometry"/></mxCell><mxCell id="c126" value="&lt;b&gt;increased (lần 2) → rose&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1252" width="380" height="22" as="geometry"/></mxCell><mxCell id="c127" value="Tránh lặp từ; dùng rise / climb / grow." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1274" width="380" height="32" as="geometry"/></mxCell><mxCell id="c128" value="Mạch lạc" style="rounded=1;arcSize=20;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Arial;fontSize=10;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="1306" width="76" height="20" as="geometry"/></mxCell><mxCell id="c129" value="&lt;b&gt;so → whereas&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1332" width="380" height="22" as="geometry"/></mxCell><mxCell id="c130" value="Dùng từ nối đối lập khi so sánh hai quốc gia." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=11;fontColor=#6B7280;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="920" y="1354" width="380" height="32" as="geometry"/></mxCell><mxCell id="c131" value="E" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Arial;align=center;" vertex="1" parent="1"><mxGeometry x="88" y="1408" width="26" height="26" as="geometry"/></mxCell><mxCell id="c132" value="&lt;b&gt;Việc nên làm trước&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="120" y="1406" width="600" height="30" as="geometry"/></mxCell><mxCell id="c133" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#E8EDFB;strokeColor=#123AB5;strokeWidth=2;fontFamily=Arial;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="120" y="1446" width="1200" height="84" as="geometry"/></mxCell><mxCell id="c134" value="&lt;b&gt;Ưu tiên: Lexical Resource (5.5)&lt;/b&gt; — tiêu chí thấp nhất của bài." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="144" y="1460" width="920" height="26" as="geometry"/></mxCell><mxCell id="c135" value="Nâng thêm 1.0 ở tiêu chí này (lên 6.5) sẽ đưa Band từ 6.0 lên 6.5 nếu các tiêu chí khác giữ nguyên." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#1F2937;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="144" y="1490" width="920" height="22" as="geometry"/></mxCell><mxCell id="c136" va